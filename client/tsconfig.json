{
    "files": [],
    "references": [
        {
            "path": "./tsconfig.app.json"
        }
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "target": "ES2020",
        "useDefineForClassFields": true,
        "allowImportingTsExtensions": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2020"
        ],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowJs": false,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
    },
    "include": [
        "src"
    ]
}