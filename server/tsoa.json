{
    "entryFile": "src/index.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": [
        "src/controllers/*.ts"
    ],
    "spec": {
        "outputDirectory": ".",
        "specVersion": 3,
        "outputFileName": "swagger.json"
    },
    "routes": {
        "routesDir": "src",
        "basePath": "/",
        "middleware": "express"
    },
    "compilerOptions": {
        "baseUrl": "."
    }
}