// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  moduleFormat = "esm"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id String @id @default(uuid())
  userId String @default("user_3C3ErmPiHCVyYTiSKMeN21Ef3b7")
  date DateTime @db.Date
  amount Int
  vendor String?
  note String?
  category_id Int?
}

model UserCategory {
  id Int @id
  userId String
  name String
  notes String
}