{
  "name": "expense-tracker-server",
  "version": "0.1.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "tsoa:routes": "tsoa routes",
    "tsoa:spec": "tsoa spec",
    "dev": "npm run tsoa:routes && npm run tsoa:spec && tsx watch src/index.ts --respawn --transpile-only src/index.ts",
    "build": "npm run tsoa:routes && npm run tsoa:spec && tsc -p .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@clerk/express": "^2.0.11",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node-dev": "^2.0.0",
    "tsoa": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
