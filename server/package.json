{
  "name": "expense-tracker-server",
  "version": "0.1.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "tsoa:routes": "tsoa routes && node scripts/fix-tsoa-routes.mjs",
    "tsoa:spec": "tsoa spec",
    "dev": "npm run tsoa:routes && npm run tsoa:spec && tsx watch src/index.ts --respawn --transpile-only src/index.ts",
    "build": "prisma generate && npm run tsoa:routes && npm run tsoa:spec && tsc -p .",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts --ignore-path .eslintignore",
    "lint:fix": "eslint . --ext .ts --ignore-path .eslintignore --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@clerk/express": "^1.2.2",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.5.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "ts-node-dev": "^2.0.0",
    "tsoa": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
